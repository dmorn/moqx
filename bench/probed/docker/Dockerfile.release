# syntax=docker/dockerfile:1

ARG ELIXIR_IMAGE=elixir:1.19.5-otp-28

FROM ${ELIXIR_IMAGE} AS builder

ARG ARTIFACT_NAME=probed.tar.gz
ARG BUILD_GIT_SHA=unknown
ARG RELEASE_NAME=probed

ENV MIX_ENV=prod \
    LANG=C.UTF-8 \
    PROBED_BUILD_GIT_SHA=${BUILD_GIT_SHA}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN mix local.hex --force && mix local.rebar --force

COPY bench/ledger/mix.exs bench/ledger/mix.lock ./bench/ledger/
COPY bench/ledger/lib ./bench/ledger/lib
COPY bench/probed/mix.exs bench/probed/mix.lock ./bench/probed/

WORKDIR /workspace/bench/probed
RUN mix deps.get --only prod

COPY bench/probed/lib ./lib

RUN mix release "${RELEASE_NAME}" --overwrite && \
    test -x "_build/prod/rel/${RELEASE_NAME}/bin/probed" && \
    mkdir -p /out && \
    tar -C "_build/prod/rel/${RELEASE_NAME}" -czf "/out/${ARTIFACT_NAME}" .

FROM scratch AS artifact
COPY --from=builder /out/ /
