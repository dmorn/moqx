# syntax=docker/dockerfile:1

ARG ELIXIR_IMAGE=elixir:1.19.5-otp-28

FROM ${ELIXIR_IMAGE} AS builder

ARG ARTIFACT_NAME=moqxprobe-burrito.tar.gz
ARG BUILD_GIT_SHA=unknown
ARG BURRITO_TARGET=linux_arm64
ARG TARGETARCH
ARG ZIG_VERSION=0.15.2

ENV MIX_ENV=prod \
    LANG=C.UTF-8 \
    MOQXPROBE_BUILD_GIT_SHA=${BUILD_GIT_SHA}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      file \
      git \
      jq \
      liblttng-ust-dev \
      libssl-dev \
      ninja-build \
      openssl \
      pkg-config \
      python3 \
      xz-utils && \
    rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "${TARGETARCH}" in \
      arm64) zig_target="aarch64-linux" ;; \
      amd64) zig_target="x86_64-linux" ;; \
      *) printf 'Unsupported Docker TARGETARCH for Zig: %s\n' "${TARGETARCH}" >&2; exit 2 ;; \
    esac; \
    curl -fsSL https://ziglang.org/download/index.json -o /tmp/zig-index.json; \
    zig_url="$(jq -r --arg version "${ZIG_VERSION}" --arg target "${zig_target}" '.[$version][$target].tarball' /tmp/zig-index.json)"; \
    zig_sha="$(jq -r --arg version "${ZIG_VERSION}" --arg target "${zig_target}" '.[$version][$target].shasum' /tmp/zig-index.json)"; \
    test "${zig_url}" != "null"; \
    test "${zig_sha}" != "null"; \
    curl -fsSL "${zig_url}" -o /tmp/zig.tar.xz; \
    printf '%s  %s\n' "${zig_sha}" /tmp/zig.tar.xz | sha256sum -c -; \
    mkdir -p /opt/zig; \
    tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; \
    rm -f /tmp/zig-index.json /tmp/zig.tar.xz; \
    /opt/zig/zig version

ENV PATH="/opt/zig:${PATH}" \
    ZIG_GLOBAL_CACHE_DIR=/workspace/.zig-cache

WORKDIR /workspace

RUN mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock README.md CHANGELOG.md LICENSE ./
COPY bench/ledger/mix.exs bench/ledger/mix.lock ./bench/ledger/
COPY bench/moqxprobe/mix.exs bench/moqxprobe/mix.lock ./bench/moqxprobe/

WORKDIR /workspace/bench/moqxprobe
RUN mix deps.get --only prod && \
    mix deps.compile snabbkaffe && \
    mix deps.compile quicer

WORKDIR /workspace
COPY lib ./lib
COPY bench/ledger/lib ./bench/ledger/lib
COPY bench/moqxprobe/lib ./bench/moqxprobe/lib
COPY bench/moqxprobe/rel ./bench/moqxprobe/rel

WORKDIR /workspace/bench/moqxprobe
RUN mix release moqxprobe_burrito --overwrite && \
    file _build/prod/rel/moqxprobe_burrito/lib/quicer-*/priv/libquicer_nif.so | grep -q 'ELF 64-bit' && \
    mkdir -p /out/bin && \
    cp "burrito_out/moqxprobe_burrito_${BURRITO_TARGET}" /out/bin/moqxprobe && \
    chmod 0755 /out/bin/moqxprobe && \
    tar -C /out -czf "/out/${ARTIFACT_NAME}" bin/moqxprobe

FROM scratch AS artifact
COPY --from=builder /out/*.tar.gz /
