# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Local secrets.
.env

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
moqx-*.tar


# Rust binary artifacts
/target/
priv/native
.moq-dev/
.tmp
.dexter*
bench/transport/results/
bench/transport/build/
bench/transport/.keys/
bench/transport/_build/
bench/transport/cover/
bench/transport/deps/
bench/transport/doc/
bench/transport/tmp/
bench/transport/.tmp/
bench/transport/*.srl
bench/transport/infra/**/.terraform/
bench/transport/infra/**/*.tfstate
bench/transport/infra/**/*.tfstate.*
bench/transport/infra/**/*.tfvars.local
bench/transport/infra/**/*.tfplan
bench/transport/infra/**/crash.log
bench/transport/infra/**/crash.*.log
